{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://login.magnehg.no/skjema/problem.schema.json",
  "title": "Bivrost: feilsvar etter RFC 9457 (application/problem+json)",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "detail",
    "instance",
    "kode",
    "korrelasjon"
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^urn:bivrost:feil:[a-z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string",
      "pattern": "^urn:uuid:"
    },
    "kode": {
      "type": "string"
    },
    "korrelasjon": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
