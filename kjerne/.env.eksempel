# Bivrost Kjerne – eksempel på .env (BIV-SIK-03). Kopier til <rot>/.env (utenfor webroten), 0640. Aldri i git.
# Installasjonen i nettleseren skriver DB_*, BIVROST_ADRESSE og nøklene.

DB_VERT="localhost"
DB_PORT="3306"
DB_NAVN="gerd"
DB_BRUKER="gerd"
DB_PASSORD=""
# DB_SOCKET="/run/mysqld/mysqld.sock"

# Nettstedets adresse (brukes i stedet for Host-hodet når Bivrost lager adresser til seg selv).
BIVROST_ADRESSE="https://gerd.example.no"
# 32 byte som base64 (lages av installasjonen): krypterer TOTP-hemmelighetene. Bytt aldri uten å lage TOTP på nytt.
BIVROST_KRYPTERINGSNOKKEL=""
# Tilfeldig nøkkel for HMAC av brukernavn og IP-adresser i tabellen over forsøk.
BIVROST_HMAC_NOKKEL=""

# Innlogging via Bivrost Sentral (fase 2). Uten BIVROST_SENTRAL_URL er bare nødinnloggingen på.
# BIVROST_SENTRAL_URL="https://login.magnehg.no"
# BIVROST_KLIENT_ID="gerd"
# BIVROST_KLIENT_HEMMELIGHET=""
# BIVROST_TILBAKE_URL="https://gerd.example.no/bivrost/innlogging/tilbake"

# Oppdatering fra GitHub.
# BIVROST_REPO="magnehg/bivrost"
# BIVROST_GITHUB_TOKEN=""                 # bare for private repo (lesetilgang)
# Utgivernøkkelen. Trengs vanligvis ikke: nøkkelen som følger med pakken (bivrost/kjerne/signeringsnokkel.offentlig)
# klareres ved installasjonen, og deretter godtas bare pakker signert med den (BIV-DRF-14). Satt her går den foran
# den klarerte, f.eks. når utgiveren har mistet den forrige nøkkelen (se README, «Bytte av utgivernøkkel»).
# BIVROST_OFFENTLIG_NOKKEL="SOjNW2FSyLjhWZF6M8Aa09AmsqNpGGJOF1KxHoZDOKY="
# GERD_OFFENTLIG_NOKKEL=""                # det samme for appen (<APP>_OFFENTLIG_NOKKEL)
# BIVROST_FORHANDSVERSJONER="0"

# Videresending av loggen som syslog (RFC 5424): udp://, tcp:// eller tls://vert:port
# BIVROST_SYSLOG="tls://siem.example.no:6514"
# Virksomhetens IANA Private Enterprise Number gir strukturerte data under «bivrost@<nummer>». Uten det sendes
# ingen strukturerte data, bare hendelsen som JSON. Søk gratis: https://www.iana.org/assignments/enterprise-numbers/
# BIVROST_SYSLOG_PEN=""

# Bare for tester og lokal utvikling: tillat HTTP når klient, server og vertsnavn er loopback. Av som standard.
# BIVROST_TILLAT_HTTP_LOKALT="0"
